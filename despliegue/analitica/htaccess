# Subdominio de la analítica → GoatCounter en 127.0.0.1:3400
#
# Este fichero se llama `.htaccess` en el servidor. Aquí se guarda sin el punto
# para que no se esconda en el repositorio.
#
# Mismo apaño que en sidebflms.com y que en el inventario, y por el mismo
# motivo: lo correcto sería que nginx hablara directamente con el servicio, pero
# la plantilla NodeJS de Hestia necesita un `node.conf` que vive en un
# directorio de root. Ver despliegue/proxy-php/proxy.php.
#
# ── QUÉ SE ABRE A INTERNET Y QUÉ NO ──────────────────────────────────────
# SÓLO `/count` y `/count.js`: lo que el navegador de cada visitante tiene que
# poder llamar para que la visita se apunte. Contraseña de Apache no se puede
# poner en esas dos rutas, porque el visitante no la tiene y la web dejaría de
# contar.
#
# TODO LO DEMÁS SE CIERRA, y eso sí es nuevo (2026-09-22). Antes esta regla
# mandaba al servicio cualquier ruta, así que el panel de GoatCounter —su
# pantalla de acceso, sus ajustes, la exportación de datos— quedaba publicado
# en internet. Tiene su propia contraseña, pero una pantalla de acceso abierta
# es algo que probar a la fuerza bruta, y aquí no hay nada delante que frene
# los intentos.
#
# PARA ENTRAR AL PANEL, un túnel por SSH desde tu equipo:
#
#     ssh -N -L 3400:127.0.0.1:3400 bote@nastos.barrasa.dev
#
# y luego abrir http://localhost:3400 en el navegador. Lo que se ve es
# exactamente lo mismo que se veía por el subdominio.

RewriteEngine On

# Let's Encrypt valida el dominio dejando un fichero aquí dentro.
RewriteCond %{REQUEST_URI} ^/\.well-known/ [NC]
RewriteRule ^ - [L]

# El propio proxy, para no entrar en bucle.
RewriteCond %{REQUEST_URI} ^/proxy\.php$
RewriteRule ^ - [L]

# Ficheros que existan de verdad aquí dentro.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Las DOS rutas de contar, y nada más, al servicio.
RewriteRule ^count(\.js)?$ /proxy.php [QSA,L]

# El resto no existe para quien venga de fuera. 404 y no 403 a propósito: no
# hace falta anunciar que ahí detrás hay un panel.
RewriteRule ^ - [R=404,L]

DirectoryIndex disabled
